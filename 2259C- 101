#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        int n ;
        cin>>n;
        vector<int> a(n);
        for(int &x:a) cin>>x;
        for(int i=0; i<n; i++){
            if(a[i]==-1) a[i]=1;
            if(a[i]==1) break;
        }
        for(int  i =n-1; i>=0; i--){
            if(a[i]==-1) a[i]=1;
            if(a[i]==1) break;
        }
        for(int &x:a){
            if(x==-1) x=0;
            cout<<x<<' ';
        }
        cout<<'\n';
    }
    return 0;
}
