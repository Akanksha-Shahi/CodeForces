#include<bits/stdc++.h>
using namespace std;
void solve(){
    int n ;
    cin>>n;
    vector<int> parent(n+1);
    for(int i =2; i<=n; ++i) cin>> parent[i];
    int m;
    cin>>m;
    vector<int> dam(n+1, 0);
    for(int i =0; i<m; ++i){
        int x;
        cin>>x;
        dam[x]=1;
    }
    vector<int> has = dam;
    vector<int> ans;
    for(int u =n; u>=2; --u){
        int p = parent [u];
        if(!has[u]) continue;
        if(has[p]){
            ans.push_back(u);
            has[u]=0;
        }
        else has[p]=1;
    }
    cout<<ans.size();
    for(int x:ans) cout<<' '<<x;
    cout<<'\n';
}
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        solve();
    }
    return 0;
}
