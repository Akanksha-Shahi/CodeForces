#include<bits/stdc++.h>
using namespace std;
using ll = long long;
void solve(){
    int n ;
    cin>>n;
    multiset<ll>s;
    for(int i =0; i<n; i++){
        ll x;
        cin>>x;
        s.insert(x);
    }
    vector<ll> ans(n);
    ll cur =0;
    for(int i =0; i<n; i++){
        auto it = s.lower_bound(1-cur);
        if(it == s.end()){
            cout<<-1<<'\n';
            return;
        }
        cur+=*it;
        ans[i]= cur;
        s.erase(it);
    }
    for(int i =0; i<n; i++){
        cout<< ans[i]<<(i+1==n?'\n':' ');
    }
}
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--)
        solve();
    return 0;    
}
