#include<iostream>
#include<string>
#include<vector>
using namespace std;
void solve(){
    int n ;
    cin>>n;
    string s;
    cin>>s;
    vector<char> st;
    for(char c:s){
        if(!st.empty() && st.back()==c) st.pop_back();
        else st.push_back(c);
    }
    if(st.empty()) cout<<"YES\n";
    else cout<<"NO\n";
}
int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    cin>>t;
    while(t--){
        solve();
    }
    return 0;
}
