#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int T;
    cin>>T;
    while(T--){
        int n ;
        cin>>n;
        string s;
        cin>>s;
        vector<bool> vis(n, false);
        int cur =0;
        vis[cur] = true;
        for(int i =0; i<n; i++){
            if(s[cur]=='R') cur++;
            else cur--;
            vis[cur]= true;
        }
        int ans =0;
        for(bool x:vis) ans+=x;
        cout<<ans<<'\n';
    }
    return 0;
}
