#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int T;
    cin>>T;
    while(T--){
        int n;
        cin>>n;
        vector<long long> a(n);
        for(auto &x:a) cin>>x;
        vector<int> ans(n,0);
        for(int i =0; i<n; i++){
            int smaller =0;
            int greater =0;
            for(int j =i+1; j<n; j++){
                if(a[j]<a[i]) smaller++;
                else if(a[j]>a[i]) greater++;
            }
            ans[i]= max(smaller, greater);
        }
        for(int i =0; i<n; i++){
            cout<<ans[i]<<(i+1 == n ? '\n': ' ');
        }
    }
    return 0;
}
