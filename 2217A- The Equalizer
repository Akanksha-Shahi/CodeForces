#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int T;
    cin>>T;
    while(T--){
        long long n,k;
        cin>>n>>k;
        long long sum =0;
        for(int i =0; i<n; i++){
            long long x;
            cin>>x;
            sum+=x;
        }
        if(sum%2==1 || (n*k)%2==0) cout<<"YES\n";
        else cout<<"NO\n";
    }
    return 0;
}
