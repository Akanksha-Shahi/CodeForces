#include<bits/stdc++.h>
using namespace std;
using int64 = long long;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int T;
    cin>>T;
    while(T--){
        int n;
        cin>>n;
        vector<int64> a(n), b(n);
        for( int i =0; i<n; i++) cin>>a[i];
        for( int i =0; i<n; i++)cin>>b[i];
        int64 sum=0, best =0;
        for( int i =0; i<n; i++){
            sum+=max(a[i], b[i]);
            best = max(best, min(a[i], b[i]));
        }
        cout<<sum+best<<'\n';
    }
    return 0;
}
