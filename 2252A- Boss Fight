#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        map<int, int> freq;
        long long sum =0;
        int mostFreq =0;
        int maxFreq =0;
        for(int i =0; i<n; i++){
            int x;
            cin>>x;
            sum+=x;
            freq[x]++;
            if(freq[x]>maxFreq){
                maxFreq = freq[x];
                mostFreq  = x;
            }
        }
        int other = n- maxFreq;
        int usable = min(maxFreq, other +2);
        long long ans = sum-1LL*maxFreq*mostFreq+1LL*usable*mostFreq;
        cout<<ans<<'\n';
    }
    return 0;
}
