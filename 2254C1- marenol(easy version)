#include<bits/stdc++.h>
using namespace std;
void solve(){
    int n;
    string a,b;
    cin>>n>>a>>b;
    int onesA = 0;
    int oddOnesA = 0;
    int onesB = 0; 
    int oddOnesB =0;
    for(int i =0; i<n; ++i){
        if(a[i]=='1'){
            ++onesA;
            if(i%2==0)++oddOnesA;
        }
        if(b[i]=='1'){
            ++onesB;
            if(i%2 == 0) ++oddOnesB;
        }
    }
    if(onesA == onesB && oddOnesA == oddOnesB) cout<<"YES\n";
    else cout<<"NO\n";
}
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        solve();
    }
    return 0;
}
