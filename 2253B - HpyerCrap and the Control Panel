#include<bits/stdc++.h>
using namespace std;
void solve(){
    int n ;
    cin>>n;
    vector<int> a(n+1);
    vector<int> b;
    for(int i =1; i<=n; ++i){
        cin>>a[i];
        if(b.empty() || a[i]!=b.back())b.push_back(a[i]);
    }
    int ans = b.size();
    for(int i =1; i<= n-1; ++i){
        if(i==2 && a[i]==a[i+1] && a[i]!= a[i-1]){
            ++ans;
            break;
        }
        if(i>=3 && a[i]==a[i+1] && a[i]!=a[i-1] && a[i-2]!=a[i]){
            ++ans;
            break;
        }
        if(i==n-2 && a[i]==a[i+1] && a[i+1]!= a[i+2]){
            ++ans;
            break;
        }
        if(i<=n-3 && a[i]==a[i+1] && a[i+1]!=a[i+2] && a[i+3]!=a[i]){
            ++ans;
            break;
        }
    }
    for(int i =3; i<=n-1; ++i){
        if(a[i]!=a[i-1] && a[i]==a[i+1] && a[i-1]==a[i-2]){
            ++ans;
            break;
        }
    }
    cout<<ans<<'\n';
}
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int TestsNumT;
    cin>>TestsNumT;
    while(TestsNumT--){
        solve();
    }
    return 0;
}
