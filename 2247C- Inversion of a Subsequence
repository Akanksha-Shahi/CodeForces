#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        int n ;
        cin>>n;
        vector<int> a(n), b(n);
        for(int &x:a) cin>>x;
        for(int &x:b) cin>>x;
        if(a==b){
            cout<<0<<'\n';
            continue;
        }
        int onesA=0;
        bool allOneB = true;
        for(int x: a) onesA+=x;
        for(int x:b){
            if(x==0) allOneB = false;
        }
        if(onesA ==0 || allOneB){
            cout<<-1<<'\n';
            continue;
        }
        int cnt =0;
        for(int i =0; i<n; i++){
            if(a[i]==1 && b[i]==0) cnt++;
        }
        cout<<(cnt%2?1:2)<<'\n';
    }
    return 0;
}
