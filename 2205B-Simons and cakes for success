#include<bits/stdc++.h>
using namespace std;
using int64 = long long;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int T;
    cin >>T;
    while(T--){
        int64 n;
        cin>>n;
        int64 ans =1;
        int64 x= n;
        for(int64 p=2; p*p<=x; p++){
            if(x%p==0){
                ans*=p;
                while(x%p==0) x/=p;
            }
        }
        if(x>1) ans*=x;
        cout<<ans<<'\n';
    }
    return 0;
}
