#include<bits/stdc++.h>
using namespace std;
using ll = long long;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        int n,m;
        cin>>n>>m;
        vector<ll> v(n);
        for(auto &x:v) cin>>x;
        vector<vector<ll>> a(n,vector<ll>(m));
        for(int i =0; i<n; ++i)
            for(int j=0; j<m; ++j)
                cin>>a[i][j];
        vector<ll> best;
        best.reserve(2*m);
        int ans =m;
        for(int i =n-1; i>=0; --i){
            for(ll x:a[i]) best.push_back(x);
            sort(best.rbegin(), best.rend());
            if((int) best.size()>m) best.resize(m);
            ll sum =0;
            for(int j =0; j<(int) best.size(); ++j){
                sum+=best[j];
                if(sum>=v[i]){
                    ans = min(ans, j+1);
                    break;
                }
            }
        }
        cout<<ans<<'\n';
    }
    return 0;
}
