#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int T;
    cin>>T;
    while(T--){
        int n;
        cin>>n;
        vector<int> p(n);
        for( int i =0; i<n; i++) cin>>p[i];
        int k =0;
        while(k<n && p[k]==n-k) k++;
        if(k ==n){
            for( int x: p) cout<<x<<" ";
            cout<<"\n";
            continue;
        }
        int pos =k;
        for( int i =k; i<n; i++){
            if(p[i]>p[pos]) pos=i;
        }
        reverse(p.begin()+k, p.begin()+pos+1);
        for( int x:p)
            cout<<x<<" ";
        cout<<"\n";    
    }
    return 0;
}
