#include<bits/stdc++.h>
using namespace std;
using ll = long long;
void solve(){
    int n; 
    long long c;
    cin>>n>>c;
    vector<ll> a(n);
    for(auto &x:a) cin>>x;
    sort(a.begin(), a.end());
    for(auto &x:a) x-=c; 
    for(int i =0; i<n/2; i++) a[i]=max(a[i],0LL);
    ll ans =0;
    for(auto x:a) ans+=x;
    cout<<ans<<"\n";
}
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        solve();
    }
    return 0;
}
