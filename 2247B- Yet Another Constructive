#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int T;
    cin>>T;
    while(T--){
        int n, k;
        long long m;
        cin>>n >>k>>m;
        if(k>m){
            cout<<"NO\n";
            continue;
        }
        cout<<"YES\n";
        for(int i =1; i<=n; i++){
            long long x;
            if(i%k==0) x= m-k+1;
            else x=1;
            cout<<x<<(i==n?'\n' : ' ');
        }
    }
    return 0;
}
