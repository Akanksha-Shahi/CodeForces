#include<bits/stdc++.h>
using namespace std;
void solve(){
    int n,k;
    cin>>n>>k;
    string s;
    cin>>s;
    for(int start=0; start<k && start<n; ++start){
        int cnt =0;
        for(int i = start; i<n; i+=k){
            cnt+=(s[i]=='1');
        }
        if(cnt&1){
            cout<<"NO\n";
            return;
        }
    }
    cout<<"YES\n";
}
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        solve();
    }
    return 0;
}
