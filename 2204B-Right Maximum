#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int T;
    cin>> T;
    while(T--){
        int n;
        cin>>n;
        vector<int> a(n);
        for( int i =0; i<n; i++) cin>>a[i];
        vector<int> rightMostMax(n);
        int mx = -1;
        int idx = -1;
        for( int i =0; i<n; i++){
            if(a[i]>mx){
                mx = a[i];
                idx =i;
            }
            else if(a[i]==mx) idx =i;
            rightMostMax[i] = idx;
        }
        int ans=0;
        int r = n-1;
        while(r>=0){
            ans++;
            r = rightMostMax[r]-1;
        }
        cout<<ans<<'\n';
    }
    return 0;
}
