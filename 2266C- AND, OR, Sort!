#include<bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        int n;
        string s;
        cin>>n>>s;
        int zeros = count(s.begin(), s.end(),'0');
        if(s[0]=='1'){
            cout<<zeros<<'\n';
            continue;
        }
        int onesleft =0;
        int zerosright = zeros;
        int ans = zeros;
        for(int i =0; i<n; i++){
            if(s[i]=='1') onesleft++;
            else zerosright--;
            ans = min(ans, onesleft+zerosright);
        }
        cout<<ans<<'\n';
    }
    return 0;
}
